# Gmail SMTP credentials
# Generate an App Password: Google Account > Security > 2FA > App Passwords
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_here

# Reply-To address (when recipients hit Reply, it goes here)
REPLY_TO=your.email@gmail.com

# BCC yourself on every email (leave blank to disable)
BCC_SELF=your.email@gmail.com

# Your details (used in email template)
SENDER_NAME=Your Full Name
ROLE=Software Engineering Intern

# Path to the Excel file (relative to project root)
EXCEL_FILE=HR Reachout List.xlsx

# Path to resume attachment (relative to project root, leave blank for no attachment)
RESUME_PATH=attachments/resume.pdf
